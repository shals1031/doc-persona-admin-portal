# Database — matches doc_persona docker-compose
DATABASE_HOST=HOST
DATABASE_PORT=PORT
DATABASE_USER=DB_USER
DATABASE_PASSWORD=DB_PASSWORD
DATABASE_NAME=DB
DATABASE_SCHEMA=DB_SCHEMA

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=admin-portal-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
ENVIRONMENT=development
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
